---
import { transform } from "astro:schema";
import { ENABLE_LINK, SITE_TITLE, SITE_TITLE_SMALL } from "../consts";

const { smallIcon } = Astro.props

---


<header>
	<nav style={{
		paddingTop: "1.5rem"
	}}>
		<div class="flex flex-row header-space items-center">
			<div class={smallIcon ? "basis-auto header-root-spsm self-center" : "basis-auto header-root-sp self-center"}> 
				<div style={{
					//transform: "translate(-1px,1px)"
				}}>
					<a href="/" style={{
						color: "#282936",
					}}>[{smallIcon ? SITE_TITLE_SMALL : SITE_TITLE}]</a>
				</div>
			</div>

			<div class="basis-auto header-element-container"> 
				<a href="/about" class="content-start"> about </a>
			</div>
			<div class="basis-auto header-element-container"> 
				<a href="/blog"> posts </a>
			</div>
			{
                ENABLE_LINK ? <div class="basis-auto header-element-container"> 
		    		<a href="/links"> links </a>
		    	</div> : void 0
			}
		</div>
	</nav>
</header>

<style>
	.header-root-spsm {
		padding: 0.2rem 0.5rem 0.2rem 0.5rem;
		margin-right: 0.5rem;
		background-color: #ebff87;
	}

	.header-root-sp {
		padding: 0.2rem 1rem 0.2rem 1rem;
		margin-right: 2rem;
		background-color: #ebff87;
	}

	.header-element-container {
		padding: 0.2rem 0.75rem 0.2rem 0.75rem;
		color: var(--accent);
		font-weight: 500;
		text-decoration: underline;
		font-size: x-large;
	}

	.header-space {
		font-family: monospace;
	}
</style>
